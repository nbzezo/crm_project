# Sao chep thanh .env roi dien gia tri that. KHONG commit .env.
# docker-compose.yml doc file nay qua `env_file` cho service `app`.
# Tren server, .github/workflows/deploy.yml tu ghi /opt/crm/.env tu GitHub Actions
# secrets truoc moi lan `docker compose up` — khong sua .env truc tiep tren server.

# --- Bat buoc ---

# Bi mat ky cookie phien dang nhap. Server TU CHOI khoi dong neu thieu.
# Sinh: openssl rand -base64 48
WORKFLOW_SESSION_SECRET=

# Tai khoan dang nhap dau tien. CHI doc MOT LAN khi bang users con rong.
# Sau do doi mat khau trong Cai dat > Tai khoan, hoac:
#   docker compose exec app node server/dist/db/resetPassword.js "<mat-khau-moi>"
WORKFLOW_ADMIN_USER=admin
WORKFLOW_ADMIN_PASSWORD=

# --- Tuy chon ---

# Khoa AES-256 ma hoa API key AI (Gemini/Claude/DeepSeek) luu trong CSDL.
# Neu de trong, ung dung tu sinh khoa trong <WORKFLOW_DATA_DIR>/.ai-master.key —
# production nen cap tuong minh tu secret manager. Sinh: openssl rand -base64 32
WORKFLOW_AI_MASTER_KEY=

# Thu muc du lieu BEN TRONG container (DB, tep tai len, backup, .ai-master.key).
# De nguyen /data — da map toi Docker volume `crm-data`.
WORKFLOW_DATA_DIR=/data
