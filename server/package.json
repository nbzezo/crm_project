{
  "name": "server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "start": "node dist/index.js",
    "start:dev": "tsx src/index.ts",
    "seed": "tsx src/db/seed.ts",
    "db:rollback": "tsx src/db/rollback.ts",
    "auth:reset-password": "tsx src/db/resetPassword.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node scripts/run-tests.mjs"
  },
  "dependencies": {
    "@workflow/contracts": "*",
    "better-sqlite3": "^12.2.0",
    "express": "^5.1.0",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "mammoth": "^1.12.1",
    "multer": "^2.2.0",
    "pdfjs-dist": "^6.2.108",
    "zod": "^4.0.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^5.0.0",
    "@types/express-session": "^1.19.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0"
  }
}
